{
  "name": "mihailobuilds-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MihailoBuilds — personal site of Mihailo Sebek, QA engineer who builds after hours.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "cv:check": "node scripts/cv-check.mjs",
    "qa:leak": "node scripts/qa/leak.mjs",
    "qa:main": "node scripts/qa/main.mjs",
    "qa:site": "node scripts/qa/site.mjs",
    "qa:shots": "node scripts/qa/shots.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
